//4. Design and implement C/C++ Program to find shortest paths from a given vertex in a weighted connected graph to other vertices using Dijkstra’s algorithm. 

#include<stdio.h>               // Standard input/output library 
#define INF 999                  // Representing infinity (no edge) 
 
// Function implementing Dijkstra's Algorithm 
void dijkstra(int c[10][10], int n, int s, int d[10]) 
{ 
    int v[10];  // Visited array (1 = included in shortest path tree) 
    int min, u, i, j;  // min = minimum distance, u = selected vertex 
 
    // Initialize distances and visited array 
    for(i=1; i<=n; i++) 
    { 
        d[i] = c[s][i]; // Distance from source to vertex i (initially direct edge) 
        v[i] = 0;       // Mark all vertices as unvisited 
    } 
 
    v[s] = 1;   // Mark source as visited (included in SPT) 
 
    // Loop to select all vertices 
    for(i=1; i<=n; i++) 
    { 
        min = INF;  // Initialize min distance 
 
        // Find the unvisited vertex with minimum distance 
        for(j=1; j<=n; j++) 
            if(v[j]==0 && d[j]<min) 
            { 
                min = d[j]; 
                u = j;  // Vertex with minimum distance 
            } 
 
        v[u] = 1;   // Include vertex u in shortest path tree 
 
        // Update distances of adjacent vertices 
        for(j=1; j<=n; j++) 
            if(v[j]==0 && (d[u] + c[u][j]) < d[j]) 
                d[j] = d[u] + c[u][j];  // Update distance if shorter path found 
    } 
} 
 
int main() 
{ 
    int c[10][10], d[10], i, j, s, n; 
 
    printf("\nEnter n value:");   
    scanf("%d",&n);  // Number of vertices 
 
    printf("\nEnter the graph data:\n"); 
    // Input adjacency matrix 
    for(i=1; i<=n; i++) 
        for(j=1; j<=n; j++) 
            scanf("%d",&c[i][j]); 
 
    printf("\nEnter the source node:"); 
    scanf("%d",&s);     // Source vertex 
 
    dijkstra(c, n, s, d);   // Call Dijkstra function 
 
    // Print shortest distances from source 
    for(i=1; i<=n; i++) 
        printf("\nShortest distance from %d to %d is %d", s, i, d[i]); 
 
    return 0;   // End program 
} 
