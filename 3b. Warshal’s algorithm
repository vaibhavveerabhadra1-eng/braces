//3B. Design and implement C/C++ Program to find the transitive closure using Warshal’s algorithm. 

#include<stdio.h>          // Standard input/output library

void warsh(int p[][10], int n)
{
    int i, j, k;       // Loop variables

    // Consider each vertex k as an intermediate vertex
    for(k = 1; k <= n; k++)

        // For every source vertex i
        for(i = 1; i <= n; i++)

            // For every destination vertex j
            for(j = 1; j <= n; j++)

                // Update reachability:
                // i can reach j if:
                // 1. A path already exists from i to j
                // OR
                // 2. i can reach k and k can reach j
                p[i][j] = p[i][j] || (p[i][k] && p[k][j]);
}

int main()
{
    int a[10][10], n, i, j;  // Adjacency matrix and loop variables

    printf("\nEnter the n value:");
    scanf("%d", &n);          // Read number of vertices

    printf("\nEnter the graph data:\n");

    // Input adjacency matrix
    for(i = 1; i <= n; i++)
        for(j = 1; j <= n; j++)
            scanf("%d", &a[i][j]);

    // Call Warshall's algorithm to compute transitive closure
    warsh(a, n);

    printf("\nResultant path matrix\n");

    // Print the transitive closure (reachability matrix)
    for(i = 1; i <= n; i++)
    {
        for(j = 1; j <= n; j++)

            // 1 = path exists, 0 = no path
            printf("%d ", a[i][j]);

        printf("\n");
    }

    return 0;   // End of program
}
